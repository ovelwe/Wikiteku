DATABASE_URL=postgres://wikiteku:wikiteku@localhost:5432/wikiteku
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Keep registration closed until a working email sender and anti-spam controls are configured.
ALLOW_LOCAL_REGISTRATION=false
# Enable only after the sending domain is verified and email flow has been tested.
PUBLIC_REGISTRATION_ENABLED=false
# Provided by Vercel Marketplace Resend; never expose to the browser.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=

# google uses the same free web provider as loxa-rpg-site; none disables new requests.
TRANSLATION_PROVIDER=google

# Comma-separated immutable user IDs, granted by the platform operator only.
# Fandom owners/admins do not automatically receive moderation access.
PLATFORM_MODERATOR_IDS=

